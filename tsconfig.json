{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["app/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
